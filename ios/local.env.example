# Copy to local.env and fill in. local.env is ignored by git.
# Device IDs: `xcrun devicectl list devices` (Identifier column).
IPHONE_UDID=00000000-0000000000000000
WATCH_UDID=00000000-0000000000000000
# Apple developer team ID (a free Apple ID works): Xcode › Settings › Accounts › your team.
TEAM_ID=ABCDE12345
# Any unique reverse-DNS id.
BUNDLE_ID=com.example.locationremote
# Optional: login-agent label prefix for install_login_agents.sh
LABEL_PREFIX=com.example
