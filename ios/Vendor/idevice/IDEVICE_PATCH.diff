+
+    /// Set a simulated location (CoreDevice / dtlocationd). Unlike DVT location simulation it
+    /// stays on the device after the connection closes, until cleared.
+    pub async fn set_simulated_location(
+        &mut self,
+        latitude: f64,
+        longitude: f64,
+    ) -> Result<plist::Value, IdeviceError> {
+        let mut input = plist::Dictionary::new();
+        input.insert("latitude".into(), plist::Value::Real(latitude));
+        input.insert("longitude".into(), plist::Value::Real(longitude));
+        self.inner
+            .invoke_with_plist_action(
+                obf!("com.apple.coredevice.feature.simulatelocation"),
+                input,
+                obf!("com.apple.coredevice.action.setsimulatedlocation"),
+            )
+            .await
+    }
+
+    /// Clear the simulated location set by `set_simulated_location`.
+    pub async fn clear_simulated_location(&mut self) -> Result<plist::Value, IdeviceError> {
+        self.inner
+            .invoke_with_plist_action(
+                obf!("com.apple.coredevice.feature.simulatelocation"),
+                plist::Dictionary::new(),
+                obf!("com.apple.coredevice.action.clearsimulatedlocation"),
+            )
+            .await
+    }
